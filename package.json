{
  "name": "karen-surgery-web",
  "version": "1.0.0",
  "private": true,
  "description": "Karen Surgery — Family Medical Practice, Nairobi (Est. 1991). Static production website built with Next.js, TypeScript, and Tailwind CSS.",
  "scripts": {
    "optimize-images": "node scripts/optimize-images.mjs",
    "dev": "next dev --port 3000",
    "build": "npm run optimize-images && next build",
    "start": "npx serve@latest out -l 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "qa": "node scripts/qa-audit.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  }
}
