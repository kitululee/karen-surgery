{
  "name": "karen-surgery-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Karen Surgery Phase 2 Backend API — Fastify, TypeScript, SQLite/PostgreSQL, Argon2id Auth, RBAC, Appointments, Enquiries, Retrieval Chatbot & CMS",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "test": "tsx src/tests/api.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "argon2": "^0.41.1",
    "fastify": "^5.2.2",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
