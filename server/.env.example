# Karen Surgery Backend API — Environment Variables
# Copy to .env and fill in real values on the server. NEVER commit .env to Git.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Database: "sqlite" (default lightweight persistent DB) or "postgres" (recommended for multi-process prod)
DB_CLIENT=sqlite
SQLITE_PATH=./data/karen-surgery.db
# DATABASE_URL=postgresql://karen_user:STRONG_PASSWORD@127.0.0.1:5432/karen_surgery

# Public & Admin Origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://localhost:5173,https://kitululee.github.io,https://www.karensurgery.com,https://admin.karensurgery.com
ADMIN_PORTAL_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Security & Sessions (generate a 64-char random hex secret: openssl rand -hex 32)
COOKIE_SECRET=change-me-generate-64-hex-chars-before-production
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL_HOURS=8

# Uploads & Data Retention
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
DATA_RETENTION_DAYS=365

# SMTP Email Configuration (leave blank until credentials are provisioned — requests still save safely)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Karen Surgery Website <no-reply@karensurgery.com>"
RECEPTION_EMAIL=Receptionist@KarenSurgery.com
